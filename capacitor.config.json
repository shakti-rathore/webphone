{
  "appId": "com.webphone.app",
  "appName": "webphone",
  "webDir": "build",
  "bundledWebRuntime": false,
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon"
    },
    "BackgroundRunner": {
      "label": "com.capacitor.background.check",
      "src": "runners/runner.js",
      "event": "checkConnection",
      "repeat": true,
      "interval": 1,
      "autoStart": true
    }
  }
}



